{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "linesmith-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "linesmith-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "design-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/design-preview-server.js"
      ],
      "port": 8123,
      "autoPort": true
    },
    {
      "name": "linesmith-dev-verify",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/dev-verify.js"
      ],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "slate-mockup",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8124",
        "--directory",
        "docs/design/slate"
      ],
      "port": 8124,
      "autoPort": false
    },
    {
      "name": "design-mockups",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8125",
        "--directory",
        "docs/design"
      ],
      "port": 8125,
      "autoPort": false
    }
  ]
}