# Copy to .env.local and fill in. .env.local is gitignored and never committed.

# Required only for the screenshot odds import feature (Claude vision).
ANTHROPIC_API_KEY=sk-ant-...

# Game-level MLB lines from the-odds-api.com (free tier: 500 credits/month).
# Leave blank to disable the integration entirely; the app degrades cleanly.
ODDS_API_KEY=

# Optional tuning for the odds cache. Defaults shown.
# A credit is charged per market per region per refresh, so the default three
# markets cost 3 credits each time. 360 minutes (6h) => ~12/day => ~360/month,
# which fits inside the free tier with headroom. Hourly would cost ~2,160/month.
# ODDS_API_TTL_MINUTES=360
# ODDS_API_MARKETS=h2h,spreads,totals
# ODDS_API_RESERVE=25

# ---------------------------------------------------------------------------
# Update 09 — five-provider odds architecture (player props)
# ---------------------------------------------------------------------------
# Every provider has an _ENABLED flag. Missing key or false flag = skipped
# silently at registration. The app must work with any subset configured,
# including none.

# --- TIER 1: unmetered workhorses (fetch freely, no budget anxiety) ---

# SharpAPI — baseline coverage. Free: 12 req/min, no monthly cap.
# 2 books only: DraftKings + FanDuel. 60s delay (real-time is paid-only).
SHARPAPI_KEY=
SHARPAPI_ENABLED=true
SHARPAPI_RATE_PER_MIN=12
SHARPAPI_DELAY_SECONDS=60

# Odds-API.io — the user's own sportsbook. Free: 100 req/hr, 500/day.
# Pick any 2 recreational books; Fanatics is the priority (the user's book).
ODDSAPIIO_KEY=
ODDSAPIIO_ENABLED=true
ODDSAPIIO_BOOKS=Fanatics,BetMGM
ODDSAPIIO_RATE_PER_HOUR=100
ODDSAPIIO_DAILY_LIMIT=500

# --- TIER 2: metered, on-demand only (never scheduled) ---

# SportsGameOdds — bookmaker breadth. Free Amateur: 2,500 objects/month,
# 10 req/min. Billed per object, not per market/book.
SPORTSGAMEODDS_KEY=
SPORTSGAMEODDS_ENABLED=true
SPORTSGAMEODDS_RATE_PER_MIN=10
SPORTSGAMEODDS_MONTHLY_LIMIT=2500
SPORTSGAMEODDS_SOFT_CAP=2000

# OddsPapi — sharp reference (Pinnacle) + free historical line movement.
# Free: 250 req/month, but each call returns the full board (350+ books).
# Extremely precious — budget for roughly 8/day.
ODDSPAPI_KEY=
ODDSPAPI_ENABLED=true
ODDSPAPI_MONTHLY_LIMIT=250
ODDSPAPI_SOFT_CAP=200

# The Odds API — same the-odds-api.com integration as ODDS_API_KEY above,
# registered as the fifth provider. Lowest priority; disabled by default —
# enable only if the coverage matrix shows the other four don't cover
# something it does.
THEODDSAPI_KEY=${ODDS_API_KEY}
THEODDSAPI_ENABLED=false
THEODDSAPI_MONTHLY_LIMIT=500

# The person's actual sportsbook. Wherever odds display, this book's price
# gets visual priority over a theoretical "best price" the person can't bet.
USER_SPORTSBOOK=Fanatics

# ---------------------------------------------------------------------------
# Multi-sport expansion (NFL, CFB, Tennis, Soccer)
# ---------------------------------------------------------------------------

# ParlayAPI (general) — NFL/CFB primary props, Soccer/EPL secondary.
# Free: 1,000 credits/month, ~3-10 credits per full-sport-slate /props pull.
PARLAYAPI_KEY=
PARLAYAPI_ENABLED=true
PARLAYAPI_MONTHLY_LIMIT=1000
PARLAYAPI_SOFT_CAP=800

# ParlayAPI (second key) — dedicated to MLB props, independent budget from
# the general key above so NFL/CFB usage never crowds out MLB or vice versa.
PARLAYAPI_MLB_KEY=
PARLAYAPI_MLB_ENABLED=true
PARLAYAPI_MLB_MONTHLY_LIMIT=1000
PARLAYAPI_MLB_SOFT_CAP=800

# Propline (general) — MLB props. Free: 1,000 requests/day (flat per call,
# not per market — the most generous daily ceiling in this stack).
PROPLINE_KEY=
PROPLINE_ENABLED=true
PROPLINE_DAILY_LIMIT=1000

# Propline (second key) — dedicated to Soccer/EPL.
PROPLINE_2_KEY=
PROPLINE_2_ENABLED=true
PROPLINE_2_DAILY_LIMIT=1000

# TheRundown — game-lines/schedule/live-score enrichment only. Free tier
# excludes player props entirely (Starter plan, $49/mo, required for that).
RUNDOWN_KEY=
RUNDOWN_ENABLED=true
